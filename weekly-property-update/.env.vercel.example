# Environment variables for the Vercel + Supabase deployment.
# Set these in the Vercel dashboard (Project → Settings → Environment Variables),
# NOT in a committed file. This is just the reference list.

# ── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:your-telegram-bot-token
# Any long random string you make up; must match what you pass to set_webhook.py.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=your-random-webhook-secret
# Your Telegram chat id (locks the bot to you). Send /start to discover it.
MANAGER_CHAT_ID=

# ── Report endpoint auth ────────────────────────────────────────────────────
# Another random string; also stored as a GitHub Actions secret (REPORT_SECRET).
REPORT_SECRET=your-random-report-secret

# ── Claude ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
ANTHROPIC_MODEL=claude-opus-4-8
# Keep "off" so report generation stays under Vercel's 60s function limit.
ANTHROPIC_THINKING=off
ANTHROPIC_MAX_TOKENS=4000

# ── Supabase ────────────────────────────────────────────────────────────────
# Project → Settings → API. Use the SERVICE ROLE key (server-side only!).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
# Dedicated schema for this app (run supabase_schema.sql, then add it under
# Settings → API → "Exposed schemas"). Defaults to "public" if unset.
SUPABASE_SCHEMA=property_update

# ── Report content / delivery ───────────────────────────────────────────────
MANAGER_NAME=Jordan Rivera
OWNERS_GREETING=Rowley family
OWNER_EMAILS=owner1@example.com, owner2@example.com
PROPERTIES=Lakehouse, Downtown Duplex, Mountain Cabin
TIMEZONE=America/Phoenix
DELIVERY_METHOD=gmail
GMAIL_SENDER=me
# Paste the FULL contents of token.json (from scripts/gmail_auth.py) on one line.
GMAIL_TOKEN_JSON=
