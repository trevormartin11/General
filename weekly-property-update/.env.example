# ── Weekly Property Update — configuration ──────────────────────────────────
# Copy this file to .env and fill in the values. Never commit your real .env.

# ── Tokens you create ───────────────────────────────────────────────────────
# Telegram bot token from @BotFather (https://t.me/BotFather).
TELEGRAM_BOT_TOKEN=123456789:your-telegram-bot-token

# Anthropic API key from https://console.anthropic.com (Settings → API keys).
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# ── Claude model (defaults are sensible; leave as-is unless you have a reason) ─
ANTHROPIC_MODEL=claude-opus-4-8
# Adaptive thinking improves grouping & expense math. Set to "off" to disable.
ANTHROPIC_THINKING=adaptive
ANTHROPIC_MAX_TOKENS=16000

# ── Who the report is from / to ─────────────────────────────────────────────
# Your name, used to sign the report.
MANAGER_NAME=Jordan Rivera
# How to address the owners, e.g. "Hartwell family" -> "Dear the Hartwell family".
# Leave blank to use a generic "the owners".
OWNERS_GREETING=Hartwell family
# Comma-separated owner email addresses (the draft is addressed to these).
OWNER_EMAILS=owner1@example.com, owner2@example.com
# Comma-separated property nicknames you use when logging notes. Optional, but
# it helps Claude group reliably. Leave blank to let it infer from your notes.
PROPERTIES=Lakehouse, Downtown Duplex, Mountain Cabin

# ── Telegram ────────────────────────────────────────────────────────────────
# The only chat allowed to use the bot, and where "draft ready" nudges go.
# Send /start to the bot to discover your chat id, then paste it here.
MANAGER_CHAT_ID=

# ── Schedule (your timezone) ────────────────────────────────────────────────
TIMEZONE=America/Phoenix
# Day/time of the automatic weekly compile. REPORT_DAY: mon,tue,wed,thu,fri,sat,sun
REPORT_DAY=fri
REPORT_HOUR=16
REPORT_MINUTE=0

# ── Delivery ────────────────────────────────────────────────────────────────
# "gmail"  -> create a Gmail draft addressed to OWNER_EMAILS (recommended)
# "telegram" -> send you the finished report in Telegram to paste yourself
DELIVERY_METHOD=gmail

# Gmail auth (only needed for DELIVERY_METHOD=gmail). On a cloud host, paste the
# full contents of token.json (from scripts/gmail_auth.py) into GMAIL_TOKEN_JSON.
# For local runs you can leave this blank and keep token.json on disk instead.
GMAIL_TOKEN_JSON=
GMAIL_TOKEN_FILE=token.json
# Usually "me" (the authorized account). Override only for a send-as alias.
GMAIL_SENDER=me

# ── Storage ─────────────────────────────────────────────────────────────────
# IMPORTANT on cloud hosts: point this at a PERSISTENT volume/disk, otherwise
# your week's notes vanish on every redeploy/restart. See DEPLOY.md.
# Local: data/entries.db   Railway: /data/entries.db   Render: /var/data/entries.db
DB_PATH=data/entries.db
